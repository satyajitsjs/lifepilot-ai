# Copy to .env at project root. Never commit actual secrets.
DEMO_MODE=true
API_SECRET=replace-with-a-long-random-secret-before-deploying
DATABASE_PATH=./lifepilot.db
FRONTEND_ORIGIN=http://localhost:3000
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
MCP_MODE=stdio
# The MCP HTTP transport is localhost-only without an OAuth proxy. Do not expose publicly as-is.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8010
# Optional approved external notifications
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
