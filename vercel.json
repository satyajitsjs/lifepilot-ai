{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_SERVICE_URL"
        }
      ]
    },
    "api": {
      "root": "services/api",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "bindings": [
        {
          "type": "service",
          "service": "mcp",
          "format": "url",
          "env": "MCP_SERVICE_URL"
        }
      ]
    },
    "mcp": {
      "root": "services/mcp-server",
      "framework": "python",
      "entrypoint": "main:app",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_INTERNAL_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
