FROM node:22-alpine
WORKDIR /app
COPY apps/web/package*.json ./
RUN npm install
COPY apps/web/ ./
ENV NEXT_TELEMETRY_DISABLED=1
# Rewrites are compiled at build time. Docker uses the internal API hostname.
ARG API_BACKEND_URL=http://api:8000
ENV API_BACKEND_URL=$API_BACKEND_URL
RUN npm run build
EXPOSE 3000
CMD ["npm", "run", "start"]
